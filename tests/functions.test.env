# Test-only settings for `supabase functions serve` (no real secrets).
# The Edge Function sends push/e-mail to a fake server run by tests/notifications.test.mjs.
EXPO_PUSH_URL=http://host.docker.internal:9099/push
RESEND_API_URL=http://host.docker.internal:9099/email
RESEND_API_KEY=test-key-not-real
EMAIL_FROM=EKO Store <test@example.com>
APP_URL=http://localhost:8081
NO_PROXY=host.docker.internal,localhost,127.0.0.1,kong
no_proxy=host.docker.internal,localhost,127.0.0.1,kong
