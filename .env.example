# EKO Store — Supabase connection (copy to .env for local development).
# Supabase → Project Settings → API (or the "Connect" button).
# Both values are PUBLIC: they are compiled into the Android/web app.
# NEVER put a secret key (sb_secret_...) or the service_role key here — the app refuses to start with one.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
